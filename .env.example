# ===== OpenAI =====
# https://platform.openai.com/api-keys 에서 발급 후 붙여넣기
OPENAI_API_KEY=sk-...

# ===== 지식원(Knowledge source) =====
# RAG 가 읽어들일 문서 폴더. 콤마로 여러 개 지정 가능.
# 기본값: stock_prod 프로젝트의 .claude/memory 전체
KNOWLEDGE_DIRS=D:/stock_prod/.claude/memory
# 추가 예시(운영 문서까지 포함하려면):
# KNOWLEDGE_DIRS=D:/stock_prod/.claude/memory,D:/stock_prod/docs

# 읽을 파일 확장자(glob), 콤마 구분
FILE_GLOBS=*.md

# ===== 임베딩 제공자 =====
# openai  → text-embedding-3-small (권장, 저렴·다국어 우수, 키 필요)
# hf      → 로컬 무료(jhgan/ko-sroberta-multitask, 키 불필요, torch 설치 필요)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ===== 생성(LLM) 제공자 =====
# openai      → gpt-4o-mini 로 답변 생성
# extractive  → LLM 없이 검색된 문서 청크만 반환(키 없이 검색 품질 데모용)
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini

# ===== 검색/분할 파라미터 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# ===== 벡터 DB 저장 위치 =====
CHROMA_DIR=./chroma_db
COLLECTION_NAME=stock_prod_memory
