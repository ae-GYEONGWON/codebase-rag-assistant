# ===== 생성(LLM) — 기본: Gemini 무료 티어 =====
# 무료 키 발급: https://aistudio.google.com/apikey  (결제수단 등록 안 하면 과금 자체가 불가능)
GOOGLE_API_KEY=
# gemini | openai | extractive(LLM 미사용, 검색 발췌만)
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
#   무료 티어 대안: gemini-2.0-flash / gemini-1.5-flash (2.5-flash 오류 시 교체)

# (선택) OpenAI 를 쓸 경우에만
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ===== 임베딩 — 기본: 로컬 무료(hf) =====
# hf      → 로컬 무료(jhgan/ko-sroberta-multitask, 키 불필요, torch 필요)
# openai  → text-embedding-3-small (키 필요)
EMBEDDING_PROVIDER=hf
HF_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== 지식원(Knowledge source) =====
KNOWLEDGE_DIRS=D:/stock_prod/.claude/memory
# 운영 문서까지 포함하려면: D:/stock_prod/.claude/memory,D:/stock_prod/docs
FILE_GLOBS=*.md

# ===== 검색/분할 파라미터 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# ===== 벡터 DB 저장 위치 =====
CHROMA_DIR=./chroma_db
COLLECTION_NAME=stock_prod_memory

# 주의: 임베딩 제공자(hf↔openai)를 바꾸면 반드시 재인덱싱: python -m app.ingest --reset
