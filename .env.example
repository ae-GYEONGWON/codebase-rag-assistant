# ===== 생성(LLM) — 기본: Gemini 무료 티어 =====
# 무료 키 발급: https://aistudio.google.com/apikey  (결제수단 등록 안 하면 과금 자체가 불가능)
GOOGLE_API_KEY=
# gemini | openai | extractive(LLM 미사용, 검색 발췌만)
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
#   대안: gemini-3.5-flash(품질 ↑, thinking 탓에 첫 토큰 ~20s) / gemini-flash-lite-latest
#   주의: gemini-2.5-flash / 2.0-flash 는 신규 발급 키에서 404(no longer available to new users)

# (선택) OpenAI 를 쓸 경우에만
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# ===== 임베딩 — 기본: 로컬 무료(hf) =====
# hf      → 로컬 무료(jhgan/ko-sroberta-multitask, 키 불필요, torch 필요)
# openai  → text-embedding-3-small (키 필요)
EMBEDDING_PROVIDER=hf
HF_EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== 코퍼스 프로필 =====
# demo    = 이 저장소 자기 자신(git 추적 파일). clone 직후 아무 설정 없이 동작한다.
# private = 아래 KNOWLEDGE_DIRS/CODE_DIRS/GIT_REPOS 로 지정한 외부 코드베이스.
CORPUS_PROFILE=demo

# ===== 지식원(Knowledge source) — private 프로필에서만 사용 =====
# 인덱싱할 대상 코드베이스의 경로로 바꾸세요.
KNOWLEDGE_DIRS=/path/to/your/repo/docs
# 여러 곳을 넣으려면 쉼표로: /path/to/your/repo/docs,/path/to/your/repo/notes
FILE_GLOBS=*.md

# ===== 지식원 — 소스코드(AST 청킹) =====
INDEX_CODE=true
CODE_DIRS=/path/to/your/repo/app,/path/to/your/repo/scripts
CODE_GLOBS=*.py

# ===== 지식원 — git 이력 ('언제 왜 바뀌었나') =====
INDEX_GIT=true
GIT_REPOS=/path/to/your/repo
GIT_MAX_COMMITS=300

# ===== 검색/분할 파라미터 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# ===== 벡터 DB 저장 위치 =====
CHROMA_DIR=./chroma_db
COLLECTION_NAME=codebase_memory

# 주의: 임베딩 제공자(hf↔openai)를 바꾸면 반드시 재인덱싱: python -m app.ingest --reset
